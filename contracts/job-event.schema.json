{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inland-resilience.local/contracts/job-event.schema.json",
  "title": "JobEvent",
  "description": "Progress event the worker adds to the Redis `job-events` stream after each status change (ADR-002). Go forwards it over SSE with `id: seq`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "seq", "status", "progress", "stage", "at"],
  "properties": {
    "schema_version": { "const": "1" },
    "job_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "status": { "$ref": "#/$defs/JobStatus" },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "stage": { "type": "string", "minLength": 1, "description": "Human-readable stage label, e.g. 'Retrieving FIRMS detections'." },
    "message": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "JobStatus": {
      "type": "string",
      "enum": ["queued", "validating", "retrieving_data", "processing_satellite", "verifying_evidence", "generating_report", "completed", "failed", "cancelled"]
    }
  }
}
